# [!] Database URL for Postgres
DATABASE_URL="postgres://..."

# [!] Session secret (random password, min. 32 characters)
SESSION_SECRET=""

# [!] Encryption keys (32 bytes, hex-encoded; generate with node scripts/encryption/generateKey.js)
ENCRYPTION_SECRET_NEW=""

# [!] Base URL
PUBLIC_URL="http://localhost:3000"

# Emails (production only)
RESEND_API_KEY=""
RESEND_FROM=""
# RESEND_REPLY_TO=""

# S3 file storage (production only)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
BUCKET_NAME="..."
# AWS_ENDPOINT_URL_S3="https://..." # Custom endpoint, if you're using a S3-compatible alternative (e.g. Tigris, R2)
# AWS_REGION="auto"                 # Custom region
# AWS_CDN_URL=""                    # Custom CDN url (for Tigris, use https://<BUCKET_NAME>.t3.tigrisbucket.io)